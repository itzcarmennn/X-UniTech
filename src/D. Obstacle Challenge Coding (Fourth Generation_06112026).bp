folder "prjs" "WRO2026FINAL"
'gyroRatio = 356/360

Function getSignature(in number port, in number sig, out number x, out number y)
  address = 80 + sig
  values = Sensor.ReadI2CRegisters(port, 1, address, 3)
  x = values[1]
  y = values[2]
EndFunction

Function setMultiplexerMode(in number port, in number chanel, in number mode)
  address = 80 + 1 * (chanel - 1)
  Sensor.WriteI2CRegister(port,address,82,mode)
EndFunction

Function getMultiplexerValue(in number port, in number chanel, out number values)
  address = 80 + 1 * (chanel - 1)
  readData = Sensor.ReadI2CRegisters(port,address,84,2)
  values = readData[1] * 256 + readData[0]
EndFunction

Sensor.SetMode(2,0)
Sensor.SetMode(4,2)
setMultiplexerMode(1,2,0)
setMultiplexerMode(1,1,0)

Sub DataReading'--------------Data Reading------------'
  While "True"
    getSignature(3,1,greenx,greeny)
    getSignature(3,2,redx,redy)
    getSignature(3,3,pinkx,pinky)
    
    gyro = Sensor.ReadRawValue(2,0)
    relativeHeading = gyro - @target
    
    getMultiplexerValue(1,1,leftWall)
    getMultiplexerValue(1,2,rightWall)
    'LCD.Clear()
    'LCD.Text(1,0,40,2,turn)
    'LCD.Text(1,0,40,2,@redy)
    'LCD.Text(1,0,60,2,@greeny)
  EndWhile
EndSub

Thread.Run = DataReading

intergal = 0
lastError = 0
Function PID(in number turn, in number kp, in number ki, in number kd)
  error = (49 + turn) - Motor.GetCount("A") '<--------------------Steering reset 44
  p = error * kp
  
  @intergal = @intergal + error
  If @intergal>5 Then
    @intergal = 5
  ElseIf @intergal<-5 Then
    @intergal=-5
  ElseIf error=0 Then
    @intergal = 0
  EndIf
  i = @intergal*ki
  
  d = (error-@lastError)*kd
  
  result = p+i+d
  Motor.StartPower("A",result)
  If result < 40 Then
    result = 38
  EndIf
  @lastError = error
EndFunction

Sub ResetSteering
  Motor.StartPower("A",-100)
  Program.Delay(350)
  While Motor.GetSpeed("A")<>0
  EndWhile
  Motor.ResetCount("A")
EndSub

wallDistance = 600 '<-----------------Follow outer wall distance
lastPillar = 0
trackWall = 0
trackPillar = 0
followWallLogic = 0
followWallResponse = 0.15'<-----------------Overall wall response
loopCount = 0
dDegrees = 0
redH = 0
greenH = 0
@Parking = 0
@gAvoid = 0
@rAvoid = 0
Time.Reset2()

Function Drive(in number speed)
  
  If Sensor.ReadRawValue(4,0) = 0 Or @leftWall = 0 Or @rightWall = 0 Then
    Motor.StartPower("D",0)
  Else
    If Time.Get2()>500 Then
      dDegrees=Motor.GetCount("D")
      Time.Reset2()
    EndIf
    stuck = Math.Abs(Motor.GetCount("D")-dDegrees)
    If stuck<>0 Then
      Time.Reset3()
    EndIf
    If Time.Get3()>200 And @trackWall=1 Then
      Motor.Start("D",speed*-5)
      'Speaker.Tone(100,800,600)
    Else
      Motor.StartPower("D",speed)
    EndIf
  EndIf
  
  If (@leftWall<150 Or @rightWall<150) And @trackWall=1 And @Parking = 0  Then 'sometimes too near to wall, the value will be 2550
    If @leftWall<150 Then
      turn = -30'-------------------steering reaction--------'
      Speaker.Tone(50,800,600)
    ElseIf @rightWall<150 Then
      turn = 30
      Speaker.Tone(50,200,600)
    EndIf
  Else
    
    '-------------------Hypothaneuse area calculation-------------------'
    greenDis = Math.SquareRoot(Math.Power(@greenx-130,2)+Math.Power(255-@greeny,2))
    redDis = Math.SquareRoot(Math.Power(@redx-130,2)+Math.Power(255-@redy,2))
    pinkDis = Math.SquareRoot(Math.Power(@pinkx-130,2)+Math.Power(255-@pinky,2))
    
    'Follow and Avoid Pillar
    If @loopCount<1 And @relativeHeading>85 Then'----------only first loop prevent u-turn-------'
      logic=0
    Else
      logic=1
    EndIf
    
    If  (greenDis<@greenH Or redDis<@redH Or pinkDis<130) And @trackPillar=1 And logic=1 Then 'show LED color 'value bigger, farer can see
      If greenDis<redDis And greenDis<pinkDis Then
        @lastPillar = 1
        EV3.SetLEDColor("GREEN","NORMAL")
        If @greeny>@gAvoid Then '<------------------------------------Green pillar y (value big, nearer) '
          turn = (@greenAvoid-@greenx)*@greeny/100*0.5 'avoid pillar
          'Speaker.Tone(30,2000,5)
        Else
          turn = (@greenFollow-@greenx)*@greeny/100*0.7 'keep car in the middle
          Speaker.Tone(20,100,50)
        EndIf
      ElseIf redDis<greenDis And redDis<pinkDis Then
        @lastPillar = 2
        EV3.SetLEDColor("RED","NORMAL")
        If @redy>@rAvoid Then'<------------------------------------Red pillar y (value big, nearer) '
          turn = (@redAvoid-@redx)*@redy/100*0.5 'avoid pillar
          'Speaker.Tone(30,1000,5)
        Else
          turn = (@redFollow-@redx)*@redy/100*0.7 'keep car in the middle
          Speaker.Tone(20,1000,50)
        EndIf
      Else
        EV3.SetLEDColor("ORANGE","NORMAL")
        If @cw=1 Then
          turn = (0-@pinkx) * @pinky/100*0.5
        Else
          turn = (255-@pinkx) * @pinky/100*0.5
        EndIf
      EndIf
    Else
      EV3.SetLEDColor("OFF","NORMAL")
      If Math.Abs(@relativeHeading) < 15 Then '-----------if langgar wall can change this---------'
        If @cw=1 Then
          followWall = (@leftWall - @wallDistance) * @followWallResponse
        Else
          followWall = (@rightWall - @wallDistance) * -@followWallResponse
        EndIf
      Else
        followWall = 0
      EndIf
      
      turn = (@relativeHeading * 1.3 + (followWall * @followWallLogic)) '*correction before relative
    EndIf
  EndIf
  
  PID(turn,5,0.1,4) '<--------------------PID Steering sensitivity '5,4
EndFunction

Function waitDegrees(in number speed, in number degrees, in number stop)
  Motor.ResetCount("D")
  While Math.Abs(Motor.GetCount("D"))<degrees
    Drive(speed)
  EndWhile
  If stop=1 Then
    Motor.Stop("D","True")
    Program.Delay(50)
  EndIf
EndFunction

Function AngleMoving(in number steering, in number speed, in number degrees, in number stop)
  Motor.ResetCount("D")
  While Math.Abs(Motor.GetCount("D"))<degrees
    If Sensor.ReadRawValue(4,0)=0 Or @leftWall=0 Or @rightWall=0 Then
      Motor.StartPower("D",0)
    Else
      Motor.StartPower("D",speed)
    EndIf
    PID(steering,5,0.1,4) '<--------------------PID Steering sensitivity
  EndWhile
  If stop=1 Then
    Motor.Stop("D","True")
    Program.Delay(50)
  EndIf
EndFunction

Function Brake(in number stop)
  If stop = 1 Then
    Motor.Stop("D", "True")
    Motor.Stop("A", "True")
    Program.Delay(200)
  EndIf
EndFunction

'------------------------ProgramStart-------------------------'

'--------------------------In the parking lot area----------------------'

ResetSteering()

If leftWall>rightWall Then  '--------ccw----------'
  Speaker.Tone(100,1000,50)
  target=90 'steering turn right
  cw=-1
  
  greenAvoid=235
  greenFollow= 140
  redAvoid=10
  redFollow=120
  @Parking = 0
  redH =130
  greenH = 130
Else                     '----------cw----------'
  Speaker.Tone(100,200,50)
  target=-90 'steering turn left
  cw=1
  
  greenAvoid=245
  greenFollow=140
  redAvoid=15
  redFollow=140
  @Parking = 0
  redH = 130
  greenH = 130
EndIf

'---------First Section Get out from magenta parking lot-------------------'

trackPillar=0  'dont open it when car is inside the parking lot (magenta mistaken as red)
trackWall=0

waitDegrees(-55,180,1)
target=target*-1
waitDegrees(55,400,0)

Speaker.Tone(100,600,100)

'-------------------Position the robot to become target 0 again---------------------'
target=0
trackWall = 0
trackPillar = 1
@gAvoid = 130
@rAvoid = 100
mainSpeed=60
redH = 190
greenH =  190
If cw=1 Then
  While Sensor.ReadRawValue(4,0)<>5 And Sensor.ReadRawValue(4,0)<>7
    Drive(mainSpeed)
  EndWhile
Else
  While Sensor.ReadRawValue(4,0)<>2 And Sensor.ReadRawValue(4,0)<>7
    Drive(mainSpeed)
  EndWhile
EndIf
Speaker.Tone(100,600,100)

'-------After First Loop-----------------
mainSpeed = 75
trackWall = 1
@gAvoid = 130
@rAvoid = 110

For loopCount = 1 To 12
  trackWall = 1
  followWallLogic = 1'<-----------------------------------------Follow Wall Logic on'
  If loopCount<7 Then
    target = target + 91 * cw
  Else
    target = target + 90.5* cw
  EndIf
  
  If cw=1 Then
    If lastPillar = 1 Then
      degrees = 1550 'cw green is last
    Else
      degrees = 1400 'cw red is last
    EndIf
    trackPillar = 1
  Else
    If lastPillar = 2 Then
      degrees = 1400 'ccw red is last
    Else
      degrees = 1550 'ccw green is last
    EndIf
    trackPillar = 1
  EndIf
  
  waitDegrees(mainSpeed,degrees,0) 'above value will put inside here
  Speaker.Tone(100,1500,100)
 
  followWallLogic = 0 '<------------------------------Follow Wall Logic off'
  If cw=1 Then
    While Sensor.ReadRawValue(4,0)<>5
      Drive(mainSpeed)
    EndWhile
    trackPillar = 1
  Else
    While Sensor.ReadRawValue(4,0)<>2
      Drive(mainSpeed)
    EndWhile
    trackPillar = 1
  EndIf
  Speaker.Tone(100,600,100)
EndFor

redH = 0
greenH = 0
greenAvoid = 0
greenFollow = 0
redAvoid = 0
redFollow = 0

'--------------------------Let's Parking!------------------------------------'
trackPillar=0
trackWall=0
mainSpeed=65
followWallLogic = 1
wallDistance=330
followWallResponse = 0.8
@Parking = 1

'---------------------------------1. Knock into wall-------------------------------------


If cw = 1 Then
  WaitDegrees(mainSpeed,700,0)
Else
  WaitDegrees(mainSpeed,1000,0)
EndIf

Brake(1)
Program.Delay(1000)

If cw = 1 Then
  'WaitDegrees(mainSpeed,50,0)
  followWallLogic = 0
  target = target - 110 'value lebih besar, car heading lebih kiri
  Speaker.Tone(100,500,1000)
Else
  'WaitDegrees(mainSpeed,330,0)
  followWallLogic = 0
  target = target + 92 'value lebih besar, car heading lebih kanan
  Speaker.Tone(100,600,100)
  
EndIf

Time.Reset5()
While Time.Get5()<5500
  Drive(80)
EndWhile
Brake(1)
Motor.Stop("D","True")
Speaker.Tone(100, 500, 100)

'-------------------------------2. Reverse ---------------------------------------------

If cw = 1 Then
  AngleMoving(-60,mainSpeed*-1,650,1)
Else
  AngleMoving(60,mainSpeed*-1,500,1)
EndIf

'-------------------------------3. Go Straight to Find Parking-----------------------------

'--------------------Walk straight heading--------------------'
If cw = 1 Then
  target = target - 85
Else
  target = target + 96  '96
EndIf

cw = cw*-1
trackwall=1
followWallLogic=1
mainSpeed=45
followWallResponse = 0.45

If cw = -1 Then '<-----------------Parking heading direction
  wallDistance = 270
  waitDegrees(mainSpeed*0.8,450,0) 'before magenta
  Speaker.Tone(50,250,500) 'sound 1
  While rightWall>120
    Drive(mainSpeed*0.8)
  EndWhile
  Brake(1)
  Speaker.Tone(50,50,50)
  Program.Delay(1000)
  waitDegrees(mainSpeed*0.8,260,0) 'cross 1st magenta
  Speaker.Tone(50,200,50) 'sound 3
  While rightWall>120
    Drive(mainSpeed*0.8)
  EndWhile
  Brake(1)
  Speaker.Tone(50,50,50)
  Program.Delay(1000)
  waitDegrees(mainSpeed,490,1) 'cross 2nd magenta
  Speaker.Tone(50,400,50)
  Program.Delay(100)
  AngleMoving(-40,-35,560,1)
  Program.Delay(100)
  AngleMoving(50,-35,540,1)
  Program.Delay(100)
  AngleMoving(0,30,85,1)
  
Else 'cw
  
  wallDistance = 260
  waitDegrees(mainSpeed*0.8,100,0) 'before magenta
  Speaker.Tone(50,250,500)
  While leftWall>120
    Drive(mainSpeed*0.8)
  EndWhile
  Brake(1)
  Speaker.Tone(50,50,50)
  Program.Delay(1000)
  waitDegrees(mainSpeed,260,0) 'cross 1nd magenta
  Speaker.Tone(50,200,50)
  While leftWall>120
    Drive(mainSpeed*0.8)
  EndWhile
  Brake(1)
  Speaker.Tone(50,50,50)
  Program.Delay(1000)
  waitDegrees(mainSpeed,620,1) 'cross 2nd magenta 310
  Speaker.Tone(50,400,50)
  Program.Delay(100)
  AngleMoving(50,-35,650,1)
  Program.Delay(100)
  AngleMoving(-40,-35,500,1)
  Program.Delay(100)
  AngleMoving(10,30,90,1)
EndIf

Brake(1)
Motor.Stop("D","True")
Speaker.Tone(100,500,100)
Program.Delay(500)